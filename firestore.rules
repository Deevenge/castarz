rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAgent() {
      return signedIn() && userRole() == 'agent';
    }
    function isActor() {
      return signedIn() && userRole() == 'actor';
    }
    function connectionDoc(agencyId, actorUid) {
      return get(/databases/$(database)/documents/connections/$(agencyId + '_' + actorUid));
    }
    function approvedConnection(agencyId, actorUid) {
      return exists(/databases/$(database)/documents/connections/$(agencyId + '_' + actorUid))
        && connectionDoc(agencyId, actorUid).data.status == 'approved';
    }
    function appliedToBrief(briefId) {
      return exists(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid));
    }
    function briefData() {
      return get(/databases/$(database)/documents/briefs/$(request.resource.data.briefId)).data;
    }
    function briefHasSpace() {
      return !(briefData().talentNeeded is number)
        || briefData().talentNeeded <= 0
        || !(briefData().applicationCount is number)
        || briefData().applicationCount < briefData().talentNeeded;
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['actor', 'agent'];
      allow update: if isOwner(uid)
        && unchanged('role')
        && unchanged('uid');
    }

    // Actors own their profiles. Agents can search and open talent profiles.
    match /actors/{uid} {
      allow get: if isOwner(uid) || isAgent();
      allow list: if isAgent();
      allow write: if isOwner(uid);
    }

    // Agencies are discoverable so actors can send connection requests.
    match /agencies/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isAgent();
    }

    match /briefs/{briefId} {
      function ownsBrief() {
        return isAgent() && resource.data.agencyId == request.auth.uid;
      }
      function publishedPublic() {
        return signedIn()
          && resource.data.status == 'published'
          && resource.data.visibility == 'public';
      }
      function publishedNetwork() {
        return isActor()
          && resource.data.status == 'published'
          && resource.data.visibility == 'network'
          && approvedConnection(resource.data.agencyId, request.auth.uid);
      }
      function actorApplicationCountIncrement() {
        return isActor()
          && resource.data.status == 'published'
          && !exists(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount', 'updatedAt'])
          && request.resource.data.applicationCount is number
          && (
            (
              resource.data.applicationCount is number
              && request.resource.data.applicationCount == resource.data.applicationCount + 1
            )
            || (
              !(resource.data.applicationCount is number)
              && request.resource.data.applicationCount == 1
            )
          )
          && (
            !(resource.data.talentNeeded is number)
            || resource.data.talentNeeded <= 0
            || request.resource.data.applicationCount <= resource.data.talentNeeded
          );
      }

      allow get: if signedIn() && (ownsBrief() || publishedPublic() || publishedNetwork() || appliedToBrief(briefId));
      allow list: if signedIn() && (ownsBrief() || publishedPublic() || publishedNetwork());
      allow create: if isAgent()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.status in ['draft', 'published', 'closed']
        && request.resource.data.visibility in ['public', 'network'];
      allow update: if (isAgent()
          && resource.data.agencyId == request.auth.uid
          && request.resource.data.agencyId == resource.data.agencyId)
        || actorApplicationCountIncrement();
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow create: if isActor()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.briefId is string
        && request.resource.data.agencyId is string
        && exists(/databases/$(database)/documents/briefs/$(request.resource.data.briefId))
        && request.resource.data.agencyId == briefData().agencyId
        && briefData().status == 'published'
        && briefHasSpace()
        && (
          briefData().visibility == 'public'
          || (briefData().visibility == 'network'
            && approvedConnection(briefData().agencyId, request.auth.uid))
        );
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if isAgent()
        && resource.data.agencyId == request.auth.uid
        && unchanged('agencyId')
        && unchanged('actorUid')
        && unchanged('briefId')
        && request.resource.data.status in ['pending', 'standby', 'booked', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'updatedAt']);
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /connections/{connectionId} {
      allow create: if isActor()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.agencyId is string
        && exists(/databases/$(database)/documents/agencies/$(request.resource.data.agencyId));
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if (isAgent()
          && resource.data.agencyId == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && request.resource.data.status in ['pending', 'approved', 'declined'])
        || (isActor()
          && resource.data.actorUid == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && request.resource.data.status in ['pending', 'withdrawn']
          && resource.data.status in ['pending', 'declined', 'withdrawn']);
    }

    match /posts/{postId} {
      function ownsPost() {
        return signedIn() && resource.data.authorUid == request.auth.uid;
      }
      function parentPost() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }
      function publicParentPost() {
        return signedIn()
          && parentPost().visibility == 'public';
      }
      function validPostAuthor() {
        return request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole in ['actor', 'agent']
          && (
            (isActor()
              && request.resource.data.authorRole == 'actor'
              && request.resource.data.actorUid == request.auth.uid
              && request.resource.data.agencyId == '')
            || (isAgent()
              && request.resource.data.authorRole == 'agent'
              && request.resource.data.agencyId == request.auth.uid
              && request.resource.data.actorUid == '')
          );
      }
      function validPostShape() {
        return request.resource.data.caption is string
          && request.resource.data.caption.size() <= 360
          && request.resource.data.authorName is string
          && request.resource.data.authorPhoto is string
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaType in ['none', 'image', 'video']
          && request.resource.data.visibility == 'public';
      }

      allow read: if signedIn()
        && resource.data.visibility == 'public';
      allow create: if signedIn()
        && validPostAuthor()
        && validPostShape();
      allow update: if ownsPost()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorRole == resource.data.authorRole
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.agencyId == resource.data.agencyId
        && validPostShape();
      allow delete: if ownsPost();

      match /likes/{uid} {
        allow read: if publicParentPost();
        allow create: if publicParentPost()
          && uid == request.auth.uid
          && request.resource.data.likerUid == request.auth.uid;
        allow delete: if signedIn()
          && (uid == request.auth.uid || parentPost().authorUid == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if publicParentPost();
        allow create: if publicParentPost()
          && request.resource.data.commenterUid == request.auth.uid
          && request.resource.data.commenterName is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 240;
        allow delete: if signedIn()
          && (resource.data.commenterUid == request.auth.uid || parentPost().authorUid == request.auth.uid);
      }
    }

    // Production guest links: anyone with the ID can view that shortlist only.
    match /shortlists/{shortlistId} {
      allow get: if true;
      allow list: if isAgent() && resource.data.agencyId == request.auth.uid;
      allow create: if isAgent() && request.resource.data.agencyId == request.auth.uid;
      allow update, delete: if isAgent() && resource.data.agencyId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow create: if isAgent()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.actorUid is string
        && request.resource.data.briefId is string
        && request.resource.data.status == 'confirmed';
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if isAgent()
        && resource.data.agencyId == request.auth.uid
        && unchanged('agencyId')
        && unchanged('actorUid')
        && unchanged('briefId')
        && request.resource.data.status in ['confirmed', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicationId',
          'agencyName',
          'actorName',
          'briefTitle',
          'location',
          'shootDate',
          'shootDateTime',
          'callTime',
          'rate',
          'status',
          'confirmedAt',
          'updatedAt',
          'cancelledAt'
        ]);
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.type in [
          'connection_request',
          'connection_approved',
          'connection_declined',
          'application_received',
          'application_standby',
          'application_rejected',
          'booking_confirmed',
          'brief_closed'
        ];
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && resource.data.participantUids.hasAny([request.auth.uid]);
      }
      function validConversationParticipants() {
        return request.resource.data.agencyId is string
          && request.resource.data.actorUid is string
          && conversationId == request.resource.data.agencyId + '_' + request.resource.data.actorUid
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.hasAll([request.resource.data.agencyId, request.resource.data.actorUid])
          && request.resource.data.participantUids.hasOnly([request.resource.data.agencyId, request.resource.data.actorUid])
          && request.resource.data.participantUids.hasAny([request.auth.uid])
          && approvedConnection(request.resource.data.agencyId, request.resource.data.actorUid);
      }
      function validConversationShape() {
        return request.resource.data.agencyName is string
          && request.resource.data.agencyName.size() <= 120
          && request.resource.data.agencyPhoto is string
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 120
          && request.resource.data.actorPhoto is string
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(request.resource.data.participantUids)
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 1000
          && request.resource.data.lastSenderUid is string;
      }
      function unchangedConversationPeople() {
        return unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('agencyName')
          && unchanged('agencyPhoto')
          && unchanged('actorName')
          && unchanged('actorPhoto')
          && unchanged('participantUids');
      }
      function validConversationReadBy() {
        return request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(resource.data.participantUids)
          && request.resource.data.readBy.hasAny([request.auth.uid]);
      }
      function validConversationDeletedFor() {
        return request.resource.data.deletedFor is list
          && request.resource.data.deletedFor.hasOnly(resource.data.participantUids)
          && request.resource.data.deletedFor.hasAny([request.auth.uid]);
      }

      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || resource.data.participantUids.hasAny([request.auth.uid])
        );
      allow list: if isParticipant();
      allow create: if signedIn()
        && validConversationParticipants()
        && validConversationShape();
      allow update: if isParticipant()
        && unchangedConversationPeople()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'lastMessageAt', 'updatedAt', 'readBy', 'deletedFor'])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && validConversationReadBy()
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor', 'updatedAt'])
            && validConversationDeletedFor()
          )
          || (
            request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 1000
            && validConversationReadBy()
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.size() == 0
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isMessageParticipant() {
          return signedIn() && parentConversation().participantUids.hasAny([request.auth.uid]);
        }

        allow read: if isMessageParticipant();
        allow create: if isMessageParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
