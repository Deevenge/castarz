rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAgent() {
      return signedIn() && userRole() == 'agent';
    }
    function isActor() {
      return signedIn() && userRole() == 'actor';
    }
    function connectionDoc(agencyId, actorUid) {
      return get(/databases/$(database)/documents/connections/$(agencyId + '_' + actorUid));
    }
    function approvedConnection(agencyId, actorUid) {
      return exists(/databases/$(database)/documents/connections/$(agencyId + '_' + actorUid))
        && connectionDoc(agencyId, actorUid).data.status == 'approved';
    }
    function appliedToBrief(briefId) {
      return exists(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid));
    }
    function briefData() {
      return get(/databases/$(database)/documents/briefs/$(request.resource.data.briefId)).data;
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['actor', 'agent'];
      allow update: if isOwner(uid)
        && unchanged('role')
        && unchanged('uid');
    }

    // Actors own their profiles. Agents can search and open talent profiles.
    match /actors/{uid} {
      allow get: if isOwner(uid) || isAgent();
      allow list: if isAgent();
      allow write: if isOwner(uid);
    }

    // Agencies are discoverable so actors can send connection requests.
    match /agencies/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isAgent();
    }

    match /briefs/{briefId} {
      function ownsBrief() {
        return isAgent() && resource.data.agencyId == request.auth.uid;
      }
      function actorApplicationAfter() {
        return getAfter(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid)).data;
      }
      function actorOpensReplacement() {
        return isActor()
          && resource.data.status == 'closed'
          && exists(/databases/$(database)/documents/applications/$(briefId + '_' + request.auth.uid))
          && actorApplicationAfter().status == 'cancelled'
          && request.resource.data.agencyId == resource.data.agencyId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'replacementOpen',
            'replacementRequestId',
            'replacementReason',
            'replacementDeadlineAt',
            'replacementCancelledActorUid',
            'replacementCancelledApplicationId',
            'updatedAt'
          ])
          && request.resource.data.replacementOpen == true
          && request.resource.data.replacementCancelledActorUid == request.auth.uid
          && request.resource.data.replacementCancelledApplicationId == briefId + '_' + request.auth.uid;
      }
      function publishedPublic() {
        return signedIn()
          && resource.data.status == 'published'
          && resource.data.visibility == 'public';
      }
      function publishedNetwork() {
        return isActor()
          && resource.data.status == 'published'
          && resource.data.visibility == 'network'
          && approvedConnection(resource.data.agencyId, request.auth.uid);
      }
      allow get: if signedIn() && (ownsBrief() || publishedPublic() || publishedNetwork() || appliedToBrief(briefId));
      allow list: if signedIn() && (ownsBrief() || publishedPublic() || publishedNetwork());
      allow create: if isAgent()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.status in ['draft', 'published', 'closed']
        && request.resource.data.visibility in ['public', 'network'];
      allow update: if (isAgent()
          && resource.data.agencyId == request.auth.uid
          && request.resource.data.agencyId == resource.data.agencyId)
        || actorOpensReplacement();
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /applications/{applicationId} {
      function actorHidesApplicationHistory() {
        return isActor()
          && resource.data.actorUid == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('briefId')
          && unchanged('status')
          && request.resource.data.actorDeleted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorDeleted', 'actorDeletedAt']);
      }
      function actorCancelsBookedApplication() {
        return isActor()
          && resource.data.actorUid == request.auth.uid
          && resource.data.status == 'booked'
          && unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('briefId')
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'replacementRequestId', 'replacementDeadlineAt', 'updatedAt']);
      }
      function actorAvailableAsReplacement() {
        return isActor()
          && resource.data.actorUid == request.auth.uid
          && resource.data.status in ['pending', 'standby', 'selected', 'rejected']
          && unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('briefId')
          && request.resource.data.status == 'replacement_available'
          && get(/databases/$(database)/documents/briefs/$(resource.data.briefId)).data.replacementOpen == true
          && request.resource.data.replacementRequestId == get(/databases/$(database)/documents/briefs/$(resource.data.briefId)).data.replacementRequestId
          && request.resource.data.replacementOriginalStatus == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'replacementRequestId', 'replacementOriginalStatus', 'replacementAvailableAt', 'updatedAt']);
      }

      allow create: if isActor()
        && request.resource.data.keys().hasOnly(['briefId', 'actorUid', 'agencyId', 'status', 'createdAt'])
        && request.resource.data.briefId is string
        && request.resource.data.agencyId is string
        && applicationId == request.resource.data.briefId + '_' + request.auth.uid
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/briefs/$(request.resource.data.briefId))
        && request.resource.data.agencyId == briefData().agencyId
        && briefData().status == 'published'
        && (
          briefData().visibility == 'public'
          || (briefData().visibility == 'network'
            && approvedConnection(briefData().agencyId, request.auth.uid))
        );
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if (isAgent()
          && resource.data.agencyId == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('briefId')
          && request.resource.data.status in ['pending', 'standby', 'selected', 'booked', 'rejected', 'cancelled', 'replacement_available']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'updatedAt']))
        || actorHidesApplicationHistory()
        || actorCancelsBookedApplication()
        || actorAvailableAsReplacement();
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /connections/{connectionId} {
      allow create: if isActor()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.agencyId is string
        && exists(/databases/$(database)/documents/agencies/$(request.resource.data.agencyId));
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if (isAgent()
          && resource.data.agencyId == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && request.resource.data.status in ['pending', 'approved', 'declined'])
        || (isActor()
          && resource.data.actorUid == request.auth.uid
          && unchanged('agencyId')
          && unchanged('actorUid')
          && request.resource.data.status in ['pending', 'withdrawn']
          && resource.data.status in ['pending', 'declined', 'withdrawn']);
    }

    match /posts/{postId} {
      function ownsPost() {
        return signedIn() && resource.data.authorUid == request.auth.uid;
      }
      function parentPost() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }
      function publicParentPost() {
        return signedIn()
          && parentPost().visibility == 'public';
      }
      function validPostAuthor() {
        return request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole in ['actor', 'agent']
          && (
            (isActor()
              && request.resource.data.authorRole == 'actor'
              && request.resource.data.actorUid == request.auth.uid
              && request.resource.data.agencyId == '')
            || (isAgent()
              && request.resource.data.authorRole == 'agent'
              && request.resource.data.agencyId == request.auth.uid
              && request.resource.data.actorUid == '')
          );
      }
      function validPostShape() {
        return request.resource.data.caption is string
          && request.resource.data.caption.size() <= 360
          && request.resource.data.authorName is string
          && request.resource.data.authorPhoto is string
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaType in ['none', 'image', 'video']
          && request.resource.data.visibility == 'public';
      }

      allow read: if signedIn()
        && resource.data.visibility == 'public';
      allow create: if signedIn()
        && validPostAuthor()
        && validPostShape();
      allow update: if ownsPost()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorRole == resource.data.authorRole
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.agencyId == resource.data.agencyId
        && validPostShape();
      allow delete: if ownsPost();

      match /likes/{uid} {
        allow read: if publicParentPost();
        allow create: if publicParentPost()
          && uid == request.auth.uid
          && request.resource.data.likerUid == request.auth.uid;
        allow delete: if signedIn()
          && (uid == request.auth.uid || parentPost().authorUid == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if publicParentPost();
        allow create: if publicParentPost()
          && request.resource.data.commenterUid == request.auth.uid
          && request.resource.data.commenterName is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 240;
        allow delete: if signedIn()
          && (resource.data.commenterUid == request.auth.uid || parentPost().authorUid == request.auth.uid);
      }
    }

    // Production guest links: anyone with the ID can view that shortlist only.
    match /shortlists/{shortlistId} {
      function ownsShortlist() {
        return isAgent() && resource.data.agencyId == request.auth.uid;
      }
      function validGuestSelection() {
        return request.auth == null
          && !resource.data.keys().hasAny(['submittedAt'])
          && (!resource.data.keys().hasAny(['expiresAt']) || request.time < resource.data.expiresAt)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'selectedActorUids',
            'productionName',
            'productionNote',
            'submittedAt',
            'updatedAt'
          ])
          && request.resource.data.selectedActorUids is list
          && request.resource.data.selectedActorUids.size() <= resource.data.publicActors.size()
          && request.resource.data.productionName is string
          && request.resource.data.productionName.size() <= 120
          && request.resource.data.productionNote is string
          && request.resource.data.productionNote.size() <= 500
          && request.resource.data.submittedAt == request.time;
      }
      allow get: if true;
      allow list: if ownsShortlist();
      allow create: if isAgent() && request.resource.data.agencyId == request.auth.uid;
      allow update: if ownsShortlist() || validGuestSelection();
      allow delete: if ownsShortlist();
    }

    match /bookings/{bookingId} {
      allow create: if isAgent()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.actorUid is string
        && request.resource.data.briefId is string
        && request.resource.data.status == 'confirmed';
      allow read: if signedIn()
        && (resource.data.actorUid == request.auth.uid || resource.data.agencyId == request.auth.uid);
      allow update: if isAgent()
        && resource.data.agencyId == request.auth.uid
        && unchanged('agencyId')
        && unchanged('actorUid')
        && unchanged('briefId')
        && request.resource.data.status in ['confirmed', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicationId',
          'agencyName',
          'actorName',
          'briefTitle',
          'location',
          'shootDate',
          'shootDateTime',
          'callTime',
          'rate',
          'status',
          'confirmedAt',
          'updatedAt',
          'cancelledAt'
        ]);
      allow delete: if isAgent()
        && resource.data.agencyId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      function validNotificationShape() {
        return request.resource.data.keys().hasOnly([
            'recipientUid',
            'senderUid',
            'type',
            'title',
            'body',
            'href',
            'read',
            'createdAt',
            'applicationId',
            'briefId',
            'connectionId'
          ])
          && request.resource.data.keys().hasAll(['recipientUid', 'senderUid', 'type', 'title', 'body', 'href', 'read', 'createdAt'])
          && request.resource.data.recipientUid is string
          && request.resource.data.senderUid is string
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.href is string
          && request.resource.data.href.size() <= 500
          && request.resource.data.read == false
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && (!request.resource.data.keys().hasAny(['applicationId']) || request.resource.data.applicationId is string)
          && (!request.resource.data.keys().hasAny(['briefId']) || request.resource.data.briefId is string)
          && (!request.resource.data.keys().hasAny(['connectionId']) || request.resource.data.connectionId is string)
          && request.resource.data.type in [
            'connection_request',
            'connection_approved',
            'connection_declined',
            'application_received',
            'application_shortlisted',
            'application_standby',
            'application_rejected',
            'booking_confirmed',
            'replacement_needed',
            'replacement_available',
            'replacement_confirmed',
            'brief_deleted',
            'brief_closed'
          ];
      }
      function hasNotificationApplication() {
        return request.resource.data.keys().hasAll(['applicationId', 'briefId'])
          && exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId));
      }
      function notificationApplication() {
        return get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data;
      }
      function notificationBrief() {
        return get(/databases/$(database)/documents/briefs/$(request.resource.data.briefId)).data;
      }
      function applicationPartiesMatchNotification() {
        return hasNotificationApplication()
          && notificationApplication().briefId == request.resource.data.briefId
          && notificationApplication().agencyId == request.resource.data.senderUid
          && notificationApplication().actorUid == request.resource.data.recipientUid;
      }
      function actorApplicationPartiesMatchNotification() {
        return hasNotificationApplication()
          && notificationApplication().briefId == request.resource.data.briefId
          && notificationApplication().actorUid == request.resource.data.senderUid
          && notificationApplication().agencyId == request.resource.data.recipientUid;
      }
      function agentApplicationNotification() {
        return isAgent()
          && applicationPartiesMatchNotification()
          && (
            (request.resource.data.type == 'application_shortlisted'
              && notificationApplication().status in ['standby', 'selected'])
            || (request.resource.data.type == 'application_standby'
              && notificationApplication().status == 'standby')
            || (request.resource.data.type == 'application_rejected'
              && notificationApplication().status == 'rejected')
            || (request.resource.data.type == 'booking_confirmed'
              && notificationApplication().status == 'booked')
            || (request.resource.data.type == 'replacement_confirmed'
              && notificationApplication().status == 'booked')
            || (request.resource.data.type == 'replacement_needed'
              && notificationBrief().agencyId == request.auth.uid
              && notificationBrief().replacementOpen == true
              && notificationApplication().status in ['pending', 'standby', 'selected', 'rejected'])
            || request.resource.data.type in ['brief_deleted', 'brief_closed']
          );
      }
      function actorApplicationNotification() {
        return isActor()
          && actorApplicationPartiesMatchNotification()
          && (
            (request.resource.data.type == 'application_received'
              && notificationApplication().status == 'pending')
            || (request.resource.data.type == 'replacement_needed'
              && notificationApplication().status == 'cancelled'
              && notificationBrief().agencyId == request.resource.data.recipientUid
              && notificationBrief().replacementOpen == true
              && notificationBrief().replacementCancelledApplicationId == request.resource.data.applicationId)
            || (request.resource.data.type == 'replacement_available'
              && notificationApplication().status == 'replacement_available'
              && notificationBrief().agencyId == request.resource.data.recipientUid
              && notificationBrief().replacementOpen == true
              && notificationApplication().replacementRequestId == notificationBrief().replacementRequestId)
          );
      }
      function hasNotificationConnection() {
        return request.resource.data.keys().hasAll(['connectionId'])
          && exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId));
      }
      function notificationConnection() {
        return get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data;
      }
      function connectionNotification() {
        return hasNotificationConnection()
          && (
            (isActor()
              && request.resource.data.type == 'connection_request'
              && notificationConnection().status == 'pending'
              && notificationConnection().actorUid == request.resource.data.senderUid
              && notificationConnection().agencyId == request.resource.data.recipientUid)
            || (isAgent()
              && request.resource.data.type in ['connection_approved', 'connection_declined']
              && notificationConnection().agencyId == request.resource.data.senderUid
              && notificationConnection().actorUid == request.resource.data.recipientUid
              && (
                (request.resource.data.type == 'connection_approved'
                  && notificationConnection().status == 'approved')
                || (request.resource.data.type == 'connection_declined'
                  && notificationConnection().status == 'declined')
              ))
          );
      }

      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn()
        && validNotificationShape()
        && (connectionNotification() || agentApplicationNotification() || actorApplicationNotification());
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    match /shootRooms/{roomId} {
      function isShootParticipant() {
        return signedIn() && resource.data.participantUids.hasAny([request.auth.uid]);
      }
      function unchangedShootPeople() {
        return unchanged('agencyId')
          && unchanged('agencyName')
          && unchanged('briefId')
          && unchanged('briefTitle')
          && unchanged('participantUids')
          && unchanged('actorSummaries');
      }
      function validShootReadBy() {
        return request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(resource.data.participantUids)
          && request.resource.data.readBy.hasAny([request.auth.uid]);
      }
      function validShootDeletedFor() {
        return request.resource.data.deletedFor is list
          && request.resource.data.deletedFor.hasOnly(resource.data.participantUids)
          && request.resource.data.deletedFor.hasAny([request.auth.uid]);
      }
      function agentManagesShootCast() {
        return isAgent()
          && resource.data.agencyId == request.auth.uid
          && unchanged('agencyId')
          && unchanged('agencyName')
          && unchanged('briefId')
          && unchanged('briefTitle')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids', 'actorSummaries', 'lastMessage', 'lastSenderUid', 'lastMessageAt', 'updatedAt', 'readBy', 'deletedFor'])
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.actorSummaries is list
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(request.resource.data.participantUids)
          && request.resource.data.deletedFor is list
          && request.resource.data.deletedFor.hasOnly(request.resource.data.participantUids)
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 1000;
      }

      allow read: if isShootParticipant();
      allow create: if isAgent()
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.briefId is string
        && request.resource.data.briefTitle is string;
      allow update: if agentManagesShootCast()
        || (isShootParticipant()
          && unchangedShootPeople()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'lastMessageAt', 'updatedAt', 'readBy', 'deletedFor'])
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && validShootReadBy()
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor', 'updatedAt'])
              && validShootDeletedFor()
            )
            || (
              request.resource.data.lastSenderUid == request.auth.uid
              && request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() > 0
              && request.resource.data.lastMessage.size() <= 1000
              && validShootReadBy()
              && request.resource.data.deletedFor is list
              && request.resource.data.deletedFor.size() == 0
            )
          ));
      allow delete: if false;

      match /actorZCards/{actorUid} {
        function parentShootRoom() {
          return get(/databases/$(database)/documents/shootRooms/$(roomId)).data;
        }
        function parentShootRoomAfter() {
          return getAfter(/databases/$(database)/documents/shootRooms/$(roomId)).data;
        }
        function isShootZCardParticipant() {
          return signedIn() && parentShootRoom().participantUids.hasAny([request.auth.uid]);
        }

        allow read: if isShootZCardParticipant();
        allow create, update: if request.resource.data.uid == actorUid
          && (
            (isAgent()
              && parentShootRoomAfter().agencyId == request.auth.uid
              && parentShootRoomAfter().participantUids.hasAny([actorUid]))
            || (signedIn()
              && request.auth.uid == actorUid
              && parentShootRoomAfter().participantUids.hasAny([request.auth.uid]))
          );
        allow delete: if false;
      }

      match /messages/{messageId} {
        function parentShootRoom() {
          return get(/databases/$(database)/documents/shootRooms/$(roomId)).data;
        }
        function isShootMessageParticipant() {
          return signedIn() && parentShootRoom().participantUids.hasAny([request.auth.uid]);
        }

        allow read: if isShootMessageParticipant();
        allow create: if isShootMessageParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && resource.data.participantUids.hasAny([request.auth.uid]);
      }
      function validConversationParticipants() {
        return request.resource.data.agencyId is string
          && request.resource.data.actorUid is string
          && conversationId == request.resource.data.agencyId + '_' + request.resource.data.actorUid
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.hasAll([request.resource.data.agencyId, request.resource.data.actorUid])
          && request.resource.data.participantUids.hasOnly([request.resource.data.agencyId, request.resource.data.actorUid])
          && request.resource.data.participantUids.hasAny([request.auth.uid])
          && approvedConnection(request.resource.data.agencyId, request.resource.data.actorUid);
      }
      function validConversationShape() {
        return request.resource.data.agencyName is string
          && request.resource.data.agencyName.size() <= 120
          && request.resource.data.agencyPhoto is string
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 120
          && request.resource.data.actorPhoto is string
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(request.resource.data.participantUids)
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 1000
          && request.resource.data.lastSenderUid is string;
      }
      function unchangedConversationPeople() {
        return unchanged('agencyId')
          && unchanged('actorUid')
          && unchanged('agencyName')
          && unchanged('agencyPhoto')
          && unchanged('actorName')
          && unchanged('actorPhoto')
          && unchanged('participantUids');
      }
      function validConversationReadBy() {
        return request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly(resource.data.participantUids)
          && request.resource.data.readBy.hasAny([request.auth.uid]);
      }
      function validConversationDeletedFor() {
        return request.resource.data.deletedFor is list
          && request.resource.data.deletedFor.hasOnly(resource.data.participantUids)
          && request.resource.data.deletedFor.hasAny([request.auth.uid]);
      }

      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || resource.data.participantUids.hasAny([request.auth.uid])
        );
      allow list: if isParticipant();
      allow create: if signedIn()
        && validConversationParticipants()
        && validConversationShape();
      allow update: if isParticipant()
        && unchangedConversationPeople()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'lastMessageAt', 'updatedAt', 'readBy', 'deletedFor'])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && validConversationReadBy()
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor', 'updatedAt'])
            && validConversationDeletedFor()
          )
          || (
            request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 1000
            && validConversationReadBy()
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.size() == 0
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isMessageParticipant() {
          return signedIn() && parentConversation().participantUids.hasAny([request.auth.uid]);
        }

        allow read: if isMessageParticipant();
        allow create: if isMessageParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
